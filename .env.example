# Copy to .env and fill in. .env is gitignored; never commit it.

# Required: OpenCode Go key used for both indexing and chat.
OPENCODE_GO_API_KEY=

# Optional provider settings.
OPENCODE_GO_BASE_URL=https://opencode.ai/inference/go/openai/v1
PAGEINDEX_MODEL=deepseek-v4.1-flash
PAGEINDEX_STORE=./.pageindex

# HTTP server.
HOST=127.0.0.1
PORT=8000
WORKERS=1
LOG_LEVEL=INFO

# Optional bearer token; when set, /api/* and /metrics require
# "Authorization: Bearer <token>". Leave empty to disable auth.
API_TOKEN=

# Request limits.
MAX_CONCURRENT=8
QUEUE_TIMEOUT=45
MAX_BODY_BYTES=65536
MAX_QUESTION_CHARS=1000
MAX_DOC_IDS=64

# Answer cache: TTL in seconds (0 disables), entries per worker.
ANSWER_CACHE_TTL=3600
ANSWER_CACHE_MAX=500

# Inject the document list into each question (1/0).
DOCUMENT_CATALOG=1
