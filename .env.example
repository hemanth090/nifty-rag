# Copy to .env and fill in. .env is gitignored; never commit it.
# Every value below is optional except OPENCODE_GO_API_KEY; the shown value is
# the built-in default. CLI flags override these for a single command.

# ── Provider ─────────────────────────────────────────────────────────────
# Required: OpenCode Go key used for both indexing and chat.
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/inference/go/openai/v1
PAGEINDEX_MODEL=deepseek-v4.1-flash
PAGEINDEX_STORE=./.pageindex

# ── Server ───────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
WORKERS=1
LOG_LEVEL=INFO

# Optional bearer token; when set, /api/* and /metrics require
# "Authorization: Bearer <token>". Leave empty to disable auth.
API_TOKEN=

# ── Request limits ───────────────────────────────────────────────────────
MAX_CONCURRENT=8          # in-flight agent runs per worker
QUEUE_TIMEOUT=45          # seconds to wait for a free slot, then 503
MAX_BODY_BYTES=65536      # request body cap
MAX_QUESTION_CHARS=1000   # question length cap
MAX_DOC_IDS=64            # document IDs per question

# ── Agent and retrieval budgets ──────────────────────────────────────────
MAX_TURNS=24              # agent turns per question
MAX_OUTPUT_TOKENS=2048    # per-turn output cap; 0 = provider default
TOOL_RESPONSE_CHARS=100000  # one tool reply, in characters (95% usable)
TOOL_MAX_PAGES=10000      # pages one page-content request may name
TOOL_SUGGESTIONS=3        # similar-name suggestions on a miss
CATALOG_CHARS=6000        # document list injected into each question (0 = no cap drop)
DOCUMENT_CATALOG=1        # 1 injects the document list, 0 disables it

# ── Answer cache ─────────────────────────────────────────────────────────
ANSWER_CACHE_TTL=3600     # seconds; 0 disables the cache
ANSWER_CACHE_MAX=500      # entries per worker

# ── Indexing budgets ─────────────────────────────────────────────────────
INDEX_MODE=flash          # flash | standard
INDEX_CONCURRENCY=16      # parallel summary calls per PDF
INDEX_OPTIMIZE=merge      # full | merge | off
INDEX_PAUSE=2             # seconds between PDFs
INDEX_SUMMARY_MAX_WORDS=150  # word cap per node summary
INDEX_REASONING_EFFORT=none  # reasoning effort for summary/expand calls
INDEX_JSON_DIR=./results
