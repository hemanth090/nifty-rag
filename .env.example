# Copy to .env and fill in. .env is gitignored; never commit it.
#
# Only the settings a deployment normally changes are listed here. Every other
# supported knob and its default (request limits, agent/retrieval budgets,
# cache, catalog, and the rest of the index tuning) is documented in
# README.md under "Configuration".

# Required: OpenCode Go key used for indexing and chat.
OPENCODE_GO_API_KEY=

# Model and provider endpoint. The endpoint default is shown and normally
# needs no override; uncomment it only for a different gateway.
PAGEINDEX_MODEL=deepseek-v4.1-flash
# OPENCODE_GO_BASE_URL=https://opencode.ai/inference/go/openai/v1

# HTTP server.
HOST=127.0.0.1
PORT=8000
WORKERS=1

# Optional bearer token. When set, /api/* and /metrics require
# "Authorization: Bearer <token>". Leave empty to disable auth.
API_TOKEN=

# Deliberate indexing overrides for this corpus on OpenCode Go. These match
# the built-in defaults; set them only if you change the defaults.
INDEX_CONCURRENCY=16
INDEX_OPTIMIZE=merge
